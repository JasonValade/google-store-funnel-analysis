# Python
__pycache__/
*.pyc
*.pyo
*.pyd
env/
venv/
.env
.venv/

# Jupyter
.ipynb_checkpoints/

# Data — scoped rules allow only the non-sensitive demo artifacts
/data/*
!/data/processed/
/data/processed/*
!/data/processed/demo/
/data/processed/demo/*
!/data/processed/demo/*.csv
!/data/processed/demo/*.csv.gz
*.parquet

# OS files
.DS_Store
Thumbs.db

# Credentials and keys - NEVER commit these
*.json
*.key
service-account-*.json
credentials.json
# Re-allow non-sensitive dashboard artifact JSON in demo folder (exception must follow *.json rule)
!data/processed/demo/*.json

# Other
.vscode/
.idea/

